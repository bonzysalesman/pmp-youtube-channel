# ============================================================
# PMP Mastery Framework — .gitignore
# ============================================================

# ─────────────────────────────────────────────
# macOS
# ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.AppleDouble
.LSOverride
Icon

# ─────────────────────────────────────────────
# Node.js
# ─────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
package-lock.json

# Build outputs
dist/
build/
.cache/
.parcel-cache/

# Jest coverage
coverage/

# ─────────────────────────────────────────────
# Environment & Secrets
# ─────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
*.pem
*.key
secrets/
credentials/

# ─────────────────────────────────────────────
# WordPress
# ─────────────────────────────────────────────
# Uploads (user media — never commit)
wp-content/uploads/

# WordPress core (use composer or download separately)
wordpress/

# WP-CLI binary
wp-cli.phar
*.phar

# WordPress auto-generated files
wp-content/cache/
wp-content/upgrade/
wp-content/backup-db/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php
wp-content/blogs.dir/
wp-config.php

# ─────────────────────────────────────────────
# Docker
# ─────────────────────────────────────────────
docker/mysql-data/
docker/wordpress-data/
*.log

# ─────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/
.eggs/
*.egg-info/
dist/
build/
.pytest_cache/

# ─────────────────────────────────────────────
# Large Binary / Media Files
# ─────────────────────────────────────────────
# PDFs (reference docs — store in cloud/shared drive)
*.pdf

# Large images & screenshots
screencapture-*.png
screencapture-*.jpg
PORTFOLIO_*.jpg
PORTFOLIO_*.png

# Template binaries
*.potx
*.pptx

# ─────────────────────────────────────────────
# IDE & Editor
# ─────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# ─────────────────────────────────────────────
# Obsidian
# ─────────────────────────────────────────────
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# ─────────────────────────────────────────────
# Staging / Sync
# ─────────────────────────────────────────────
staging-server

# ─────────────────────────────────────────────
# Test outputs
# ─────────────────────────────────────────────
test-results/
playwright-report/
